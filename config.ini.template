[META_API]
# Your Meta App credentials
# You can get these from the Meta Developer Dashboard: https://developers.facebook.com/apps/
my_app_id = YOUR_APP_ID
my_app_secret = YOUR_APP_SECRET

# A long-lived user access token with the 'ads_management' permission
# See README.md for instructions on how to generate this.
my_access_token = YOUR_ACCESS_TOKEN

# Your Ad Account ID
# Find this in your Ads Manager URL (e.g., act=xxxxxxxxxxxx)
ad_account_id = act_YOUR_AD_ACCOUNT_ID

# The ID of the Facebook Page you want to advertise from.
page_id = YOUR_PAGE_ID

[OPENAI_API]
# Your API key from OpenAI (platform.openai.com)
api_key = YOUR_OPENAI_API_KEY
